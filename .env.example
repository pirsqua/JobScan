# Copy to .env and fill in. Never commit the real .env file.

# Required for the `evaluate` command (job + company LLM screening).
ANTHROPIC_API_KEY=

# The folder holding your personal files — candidate profile, applications and employer registry
# (names in config/settings.yaml, personal_files). Unset, it is the repo's gitignored private/.
# Point it at a synced folder to have them backed up; every `run` then also backs the database
# up there. Start from config/candidate_profile.example.yaml, data/applications.example.yaml and
# data/companies.example.yaml.
# JOBSCAN_DATA_DIR=C:/Users/you/Drive/JobScan-data

# Optional overrides (defaults live in config/settings.yaml).
# JOBSCAN_DB_PATH=data/jobscan.db
# JOBSCAN_OUTPUT_DIR=out
# JOBSCAN_ANTHROPIC_MODEL=claude-sonnet-5-5
# JOBSCAN_ANTHROPIC_THINKING=between_tools
# JOBSCAN_TRIAGE_MODEL=claude-haiku-5-5
# JOBSCAN_TRIAGE_THINKING=disabled
# JOBSCAN_LOG_LEVEL=INFO
