# Copy to .env and fill in. Never commit the real .env file.

# Required for the `evaluate` command (job + company LLM screening).
ANTHROPIC_API_KEY=

# Your personal files — keep them outside the repository (a synced folder backs them up).
# Start from config/candidate_profile.example.yaml, data/applications.example.yaml and
# data/companies.example.yaml.
# JOBSCAN_PROFILE_PATH=C:/Users/you/Drive/JobScan-data/candidate_profile.yaml
# JOBSCAN_APPLICATIONS_PATH=C:/Users/you/Drive/JobScan-data/applications.yaml
# JOBSCAN_REGISTRY_PATH=C:/Users/you/Drive/JobScan-data/companies.yaml
# Where `backup` (and every `run`) snapshots the database.
# JOBSCAN_BACKUP_DIR=C:/Users/you/Drive/JobScan-data

# Optional overrides (defaults live in config/settings.yaml).
# JOBSCAN_DB_PATH=data/jobscan.db
# JOBSCAN_ANTHROPIC_MODEL=claude-sonnet-5
# JOBSCAN_LOG_LEVEL=INFO
